# ERPNext Configuration
# Copy this file to .env.local and fill in your actual values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8081

# ERPNext Connection
ERPNEXT_BASE_URL=http://localhost:8080
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here
ERPNEXT_COMPANY=Your Company Name
ERPNEXT_ITEM_ID=ITEM-001

# Optional ERPNext Settings (use defaults if not specified)
ERPNEXT_SUPPLIER=NovaTech Trading
ERPNEXT_CURRENCY=USD
ERPNEXT_CONVERSION_RATE=1
